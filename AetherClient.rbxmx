range(&quot;Theme&quot;,&quot;glass&quot;,&quot;Glass opacity %&quot;,81,10,100);range(&quot;Theme&quot;,&quot;rim&quot;,&quot;Neon rim %&quot;,55,0,100);toggle(&quot;Theme&quot;,&quot;sparkles&quot;,&quot;Floating sparkles&quot;,true)
