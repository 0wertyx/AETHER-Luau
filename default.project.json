{
  "name": "AETHER",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Aether": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "AetherPeerVisuals": {
        "$path": "src/server/PeerVisuals.server.luau"
      },
      "AetherCameraSettings": {
        "$path": "src/server/CameraSettings.server.luau"
      },
      "AetherProfiles": {
        "$path": "src/server/Profiles.server.luau",
        "Schema": {
          "$path": "src/shared/Schema.luau"
        }
      },
      "AetherLiveUpdates": {
        "$path": "src/server/LiveUpdates.server.luau",
        "$attributes": {
          "EnabledRelay": true
        }
      }
    },
    "StarterPlayer": {
      "$properties": {"EnableMouseLockOption": false},
      "StarterPlayerScripts": {
        "AetherClient": {
          "$path": "src/client/Aether.client.luau"
        }
      }
    }
  }
}
