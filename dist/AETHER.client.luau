function S.copy(v) if type(v)~="table" then return v end;local r={};for k,x in v do r[k]=S.copy(x) end;return r end
local function str(s,n) return type(s)=="string" and #s<=n and utf8.len(s)~=nil end
local function name(s) return str(s,48) and s:match("%S") and not s:find("%c") end
local function hex(s) return type(s)=="string" and #s==6 and s:match("^%x+$")~=nil end
function S.value(k,v)
 -- Deprecated effects stay readable in old banks but cannot be enabled in this edition.
 if (k=="neon" or k=="aura" or k=="trail" or k=="visualBloom" or k=="dock") and type(v)=="boolean" then return false end
 if k=="topCapsule" and type(v)=="boolean" then return true end
 if k=="lastPage" and v=="HUD" then return "Clock" end
 local d=S.defs[k];if not d then error("Unknown setting: "..tostring(k),0) end
 local a=d.kind
 if a=="bool" and type(v)=="boolean" then return v end
 if a=="angle" and type(v)=="number" and v==v and math.abs(v)<math.huge then return v end
 if a=="number" and type(v)=="number" and v==math.floor(v) and v>=d.min and v<=d.max then return v end
 if a=="optionalReal" and v==false then return false end
 if (a=="real" or a=="optionalReal") and type(v)=="number" and v==v and math.abs(v)<math.huge and v>=d.min and v<=d.max then return v end
 if a=="choice" and table.find(d.min,v) then return v end
 if a=="color" and hex(v) then return string.upper(v) end
 if a=="text" and str(v,d.max) then return v end
 if a=="asset" and str(v,16) and (v=="" or v:match("^[1-9]%d*$")) then return v end
 if a=="players" and type(v)=="table" then local r,n={},0;for id,o in v do
   n+=1;assert(n<=16 and str(id,18) and id:match("^%-?%d+$") and type(o)=="table" and str(o.label,32) and hex(o.color) and table.find(S.shapes,o.shape),"Invalid player override");r[id]={label=o.label,color=o.color,shape=o.shape}
  end;return r end
 error("Invalid value: "..k,0)
end
-- Same-server opt-in cosmetic protocol. No account information, chat, inventory,
-- controls, HUD, targeting, scripts, world lighting or external endpoints.
local peerGroups={Character=true,Wings=true,Halos=true}
S.peerKeys={}
for _,k in S.order do
 local d=S.defs[k]
 if (peerGroups[d.group] and k~="aura" and k~="trail" and k~="motionPlayback" and k~="motionStudioConfig" and not k:find("^visualBloom")) or k=="reduce" or k=="secondary" then
  if d.kind=="bool" or d.kind=="number" or d.kind=="choice" or d.kind=="color" then S.peerKeys[k]=true end
 end
end
local function peerNumber(v,lo,hi,default)
 if type(v)=="number" and v==v and v>=lo and v<=hi then return v end
 return default
end
function S.peerPacket(raw)
 assert(type(raw)=="table","Expected cosmetic settings")
 local packet={};local count=0
 for k,v in raw do
  count+=1;assert(count<=256,"Too many cosmetic fields")
  if S.peerKeys[k] then
   local value=S.value(k,v)
   if value~=S.defs[k].default then packet[k]=value end
  elseif S.defs[k] and (S.defs[k].group=="Neon" or k=="aura" or k=="trail") then
   -- Ignore removed cosmetics from older compatible peers.
  elseif k=="motionStudioConfig" then
   assert(type(v)=="string" and #v<=2048,"Invalid motion config")
   local ok,config=pcall(function() return game:GetService("HttpService"):JSONDecode(v) end)
   if ok and type(config)=="table" then
    local style=raw.walkStyle or S.defs.walkStyle.default
    local rate=peerNumber(type(config.packRates)=="table" and config.packRates[style],.25,2,peerNumber(config.speed,.25,2,1))
    local clean={speed=rate,adaptive=config.adaptive~=false,origin=peerNumber(config.origin,0,150,100),height=peerNumber(config.height,0,1.5,0),props=config.props~=false,packRates={[style]=rate}}
    packet.motionStudioConfig=game:GetService("HttpService"):JSONEncode(clean)
   end
  elseif k=="publishedMotion" then
   assert(type(v)=="boolean","Invalid motion flag")
   if v then packet.publishedMotion=true end
  else error("Not a cosmetic field",0) end
 end
 return packet
end
function S.peerSettings(packet)
 local clean=S.peerPacket(packet)
 local out=S.defaults()
 for k,v in clean do if k~="publishedMotion" then out[k]=v end end
 -- Published Animator tracks already replicate normally. Never play another
 -- player's asset or overwrite their published tracks on the observer.
 out.peerPublished=clean.publishedMotion==true
 out.motionPlayback="Local"
 return out
end
function S.capturePeer(settings,publishedMotion,physicalLift)
 local data={}
 for k in S.peerKeys do data[k]=settings[k] end
 if settings.motionStudioConfig~="" then data.motionStudioConfig=settings.motionStudioConfig end
 if publishedMotion then data.publishedMotion=true end
 local packet=S.peerPacket(data)
 if physicalLift and packet.motionStudioConfig then
  local http=game:GetService("HttpService")
  local config=http:JSONDecode(packet.motionStudioConfig)
  config.height=0
  packet.motionStudioConfig=http:JSONEncode(config)
 end
 return packet
end
