                end
                lastApplied=desired
                vb.tiltHooks=(vb.tiltHooks or 0)+1
            else
                releaseLocalTilt()
            end
            return table.unpack(result,1,result.n)
        end
        pt._handleTilt=wrappedTilt
    end
    function vb:available() return available() end
