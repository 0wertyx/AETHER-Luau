 local basis=jointC0.Rotation
 local a=M.jointFrames(m)
 local scale=if a then math.clamp(a.Size.Y/2,.5,1.7) else 1
 return basis:Inverse()*CFrame.new(cf.Position*scale)*cf.Rotation*basis
