    local screen = U.new("ScreenGui", {
        Name = "AETHER_Cursor", ResetOnSpawn = false,
        IgnoreGuiInset = true, DisplayOrder = 10000,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
    }, playerGui)
    scope:add(screen)
